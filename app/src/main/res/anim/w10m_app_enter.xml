<?xml version="1.0" encoding="utf-8"?>
<!-- W10M dive, last beat: after the Start zoom goes black the app
     materializes full screen, settling from slightly large (the camera
     still diving forward) while it fades in, ~120ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="120" />
    <scale android:fromXScale="1.06" android:toXScale="1.0"
        android:fromYScale="1.06" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="160" />
</set>
